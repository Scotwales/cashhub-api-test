# For integration tests, use the CashHub Authentication API base URL.
# Leave blank to run only the offline contract tests.
BASE_URL=

# Optional JWT from POST /api/v1/Auth/login for authenticated API requests.
API_TOKEN=

# Optional dedicated test account for non-destructive authentication tests.
CASHHUB_TEST_USERNAME=
CASHHUB_TEST_PASSWORD=

# Optional resource identifiers for API integration tests that use path parameters.
# Set the parameter name in uppercase, for example:
# CASHHUB_TEST_PARAM_INVENTORY_ID=
# CASHHUB_TEST_PARAM_REQUEST_ID=
# CASHHUB_TEST_PARAM_TERMINAL_ID=
# CASHHUB_TEST_PARAM_USER_ID=

# State-changing API requests are never sent unless explicitly enabled.
# Use a dedicated disposable test environment and test account.
CASHHUB_ENABLE_MUTATION_TESTS=false

# Optional schema field overrides use uppercase field names, for example:
# CASHHUB_TEST_DATA_OTP_CODE=
# CASHHUB_TEST_DATA_SESSION_TOKEN=
# CASHHUB_TEST_DATA_ACCOUNT_ID=
# CASHHUB_TEST_DATA_NEW_PASSWORD=
#
# Multipart upload tests require an existing fixture file:
# CASHHUB_TEST_FILE_IMAGE=/absolute/path/to/test-image.png
