# For integration tests, use the CashHub Authentication API base URL.
# Leave blank to run framework-only tests without network requests.
BASE_URL=

# Optional JWT from POST /api/v1/Auth/login for authenticated API requests.
API_TOKEN=

# Optional dedicated test account for non-destructive authentication tests.
CASHHUB_TEST_USERNAME=
CASHHUB_TEST_PASSWORD=

# Optional resource identifiers for GET integration tests that use path parameters.
# Set the parameter name in uppercase, for example:
# CASHHUB_TEST_PARAM_INVENTORY_ID=
# CASHHUB_TEST_PARAM_REQUEST_ID=
# CASHHUB_TEST_PARAM_TERMINAL_ID=
# CASHHUB_TEST_PARAM_USER_ID=
