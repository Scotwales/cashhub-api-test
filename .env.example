# For integration tests, use the CashHub Authentication API base URL.
# Leave blank to run only the offline contract test in CI.
BASE_URL=

# Optional JWT from POST /api/v1/Auth/login for authenticated API requests.
API_TOKEN=

# Required only by login and change-password flows that must use an existing account.
CASHHUB_TEST_USERNAME=
CASHHUB_TEST_PASSWORD=

# Resource identifiers used in paths, query strings, and request bodies are
# resolved automatically: test-data/apiFixtures.js uses an override when set,
# otherwise fetches an existing record, otherwise creates the prerequisite.
# Overrides are optional and take the form:
# CASHHUB_TEST_PARAM_<PATH_PARAMETER>=     (for example CASHHUB_TEST_PARAM_USER_ID)
# CASHHUB_TEST_DATA_<FIELD>=               (for example CASHHUB_TEST_DATA_ACCOUNT_ID)
# Resolvers may create users, outlets, inventory, terminals, or POS requests in
# the target environment. Point BASE_URL at a disposable environment.

# Names, emails, usernames, phone numbers, addresses, device identifiers,
# registration/password-change passwords, and references are generated by
# data-generator/TestDataGenerator.js. Do not configure them here.

# Optional overrides for values the API cannot provide or create.
# Set the field name in uppercase, for example:
# CASHHUB_TEST_DATA_OTP_CODE=
# CASHHUB_TEST_DATA_PIN=
# CASHHUB_TEST_DATA_SESSION_TOKEN=
# CASHHUB_TEST_DATA_REFRESH_TOKEN=
#
# Multipart upload tests require an existing fixture file:
# CASHHUB_TEST_FILE_IMAGE=/absolute/path/to/test-image.png
